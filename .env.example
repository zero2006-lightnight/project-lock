# ── StudyPilot environment ──────────────────────────────────────────────
# Copy to .env and fill in what you need. The app runs fully with no AI key:
# the built-in StudyPilot engine powers planning, rescheduling, stats and
# structured chat intents. Set a provider key to unlock the AI tutor,
# free-form chat, LLM quiz/flashcard generation and richer explanations.

# Database (local SQLite by default; PostgreSQL-ready).
# SQLite:  DATABASE_URL="file:./data/studypilot.db"
# Postgres (after switching driver): DATABASE_URL="postgresql://user:pass@host:5432/studypilot"
DATABASE_URL="file:./data/studypilot.db"

# AI provider (optional). 'openai' also accepts any OpenAI-compatible endpoint
# (OpenRouter, Groq, Together, local llama.cpp, ...) via AI_BASE_URL.
# For Render, add these values in the service's Environment Variables section
# instead of committing them to GitHub.
AI_PROVIDER=""
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gpt-4o-mini"
AI_EMBED_MODEL="text-embedding-3-small"

# ── Multi-provider chain (real models + automatic failover) ──────────
# Priority order = failover order. First keyed provider answers; on any
# failure the next keyed provider tries; when all are down the app falls
# back to its deterministic local engine. Rollback: snapshot before
# changes with `node scripts/ai-config.mjs snapshot`, restore with
# `node scripts/ai-config.mjs restore <file>`.
AI_PRIORITY="openrouter,grok,gemini"

# OpenRouter (https://openrouter.ai/keys) — primary. Speaks the OpenAI
# dialect for chat + embeddings + vision. Model IDs need the vendor
# prefix, e.g. "openai/gpt-4o-mini", "qwen/qwen-2.5-7b-instruct".
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBED_MODEL="openai/text-embedding-3-small"
# Optional attributions sent as headers (improve rate limits / ranking):
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="StudyPilot"

# xAI Grok (https://console.x.ai) — OpenAI dialect at api.x.ai/v1.
GROK_API_KEY=""
GROK_MODEL="grok-3-mini"

# Google Gemini (https://aistudio.google.com/apikey) — native dialect
# with streaming support.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Google OAuth (optional). Create an OAuth client in Google Cloud Console
# (https://console.cloud.google.com/apis/credentials) and add this app's URL as an
# authorized redirect URI:
#   http://localhost:3000/auth/google/callback
# (For production use https://your-domain.com/auth/google/callback and restart the app.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL (used for absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
